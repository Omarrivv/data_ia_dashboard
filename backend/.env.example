# Base de datos
MONGODB_URI=mongodb://localhost:27017/dashboard-platform

# JWT
JWT_SECRET=tu-jwt-secret-super-seguro-cambialo-en-produccion

# Gemini AI
GEMINI_API_KEY=AIzaSyAoF1cm2X9C5bOrqEZuIT2tZVN6-cV5aAI

# Servidor
PORT=5000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting (granular by endpoint type)
# Global (fallback for unspecified endpoints)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth (login/register): very strict, 5 attempts per 15 min to prevent brute force
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Read operations (GET): flexible, 100 per 15 min
RATE_LIMIT_READ_WINDOW_MS=900000
RATE_LIMIT_READ_MAX=100

# Analysis/AI operations: moderate, 10 per hour (resource-intensive)
RATE_LIMIT_ANALYSIS_WINDOW_MS=3600000
RATE_LIMIT_ANALYSIS_MAX=10

# Uploads: moderate, 20 per hour (bandwidth/storage intensive)
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=20

# Admin operations: very strict, 20 per 10 min (sensitive operations)
RATE_LIMIT_ADMIN_WINDOW_MS=600000
RATE_LIMIT_ADMIN_MAX=20

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Gemini Cache & Retries
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_MS=500

# Analysis Job Queue
ANALYSIS_CONCURRENCY=2